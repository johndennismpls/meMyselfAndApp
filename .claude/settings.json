{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Bash(*.env)",
      "Bash(*.env *)",
      "Bash(*.env|*)",
      "Bash(*.env;*)",
      "Bash(*.env.local*)"
    ]
  }
}
