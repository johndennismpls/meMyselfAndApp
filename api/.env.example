# Postgres connection string used by the app and by drizzle-kit.
DATABASE_URL=postgresql://user:password@localhost:5432/memyselfandapp

# Optional: max connections in the pg pool (default 10).
# DATABASE_POOL_MAX=10

# Recipe Box (spec/02_recipebox.md §10).
# Required — the recipes module refuses to boot without it. Goes in .env, which
# is gitignored; confirm that before the first commit.
ANTHROPIC_API_KEY=

# Where downloaded and uploaded recipe images live. Created at boot if missing.
# RECIPE_MEDIA_DIR=./var/media/recipes

# Per-request timeout when the server fetches a recipe page (§4.1).
# RECIPE_FETCH_TIMEOUT_MS=10000

# Cleaned-page character cap. Over this is a 413, never a silent truncation (§4.2).
# RECIPE_MAX_PAGE_CHARS=250000

# How many discovery candidates /recipes/find will try (§7.1).
# RECIPE_MAX_CANDIDATES=3
